Q4. Read a CSV file (Iris dataset) and display its first five rows

# Note: The environment has no internet access, so instead of downloading
# from Kaggle, the Iris dataset is generated locally via scikit-learn and
# saved as iris.csv. If you already have iris.csv from Kaggle, place it in
# the same folder as this script and this cell will use that one instead.

import os

if not os.path.exists("iris.csv"):
    from sklearn.datasets import load_iris
    iris_raw = load_iris(as_frame=True)
    iris_df = iris_raw.frame
    iris_df["species"] = iris_raw.target_names[iris_raw.target]
    iris_df.to_csv("iris.csv", index=False)

iris_df = pd.read_csv("iris.csv")
print("\nQ4: First 5 rows of Iris dataset")
print(iris_df.head())




