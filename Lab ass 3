e) Statistics
avg_salary = emp_df["Salary"].mean()
total_bonus = emp_df["Bonus"].sum()
youngest_age = emp_df["Age"].min()
highest_rating = emp_df["Rating"].max()

print("\nQ6.e.i: Average salary =", avg_salary)
print("Q6.e.ii: Total bonus paid =", total_bonus)
print("Q6.e.iii: Youngest employee's age =", youngest_age)
print("Q6.e.iv: Highest performance rating =", highest_rating)


# f) Sort by Salary descending
emp_sorted = emp_df.sort_values(by="Salary", ascending=False)
print("\nQ6.f: Sorted by Salary (descending)")
print(emp_sorted)



# g) Add Performance_Category column
def categorize_rating(rating):
    if rating >= 4.5:
        return "Excellent"
    elif rating >= 4.0:
        return "Good"
    else:
        return "Average"

emp_df["Performance_Category"] = emp_df["Rating"].apply(categorize_rating)
print("\nQ6.g: Added Performance_Category column")
print(emp_df[["Name", "Rating", "Performance_Category"]



# h) Identify missing values
print("\nQ6.h: Missing values per column")
print(emp_df.isnull().sum())


# i) Rename Employee_ID to ID
emp_df = emp_df.rename(columns={"Employee_ID": "ID"})
print("\nQ6.i: Renamed Employee_ID -> ID")
print(emp_df.columns.tolist())



# j) Filtering
exp_gt_5 = emp_df[emp_df["Years_of_Experience"] > 5]
print("\nQ6.j.i: Employees with more than 5 years experience")
print(exp_gt_5)

it_dept = emp_df[emp_df["Department"] == "IT"]
print("\nQ6.j.ii: Employees in IT department")
